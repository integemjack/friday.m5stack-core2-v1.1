# M5Stack Core2 v1.1（ESP32 + 16MB Flash + 8MB PSRAM）
CONFIG_IDF_TARGET="esp32"

# Flash / 时钟
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESP32_DEFAULT_CPU_FREQ_240=y

# PSRAM：WebRTC（DTLS/SCTP 缓冲）和 TLS 会话都在 PSRAM 里
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# 分区
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILE="partitions.csv"

# WebRTC（esp_peer）：DTLS + SRTP（虽然只用 DataChannel，栈要能协商）
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_SSL_DTLS_SRTP=y
CONFIG_MBEDTLS_PSK_MODES=y

# chatserver 是自签证书：跳过校验（TODO 固件 v2：TOFU 指纹锁定）
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_CERT_COMMON_NAME_CHECK=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

# FreeRTOS：esp_peer 要求 1000Hz tick
CONFIG_FREERTOS_HZ=1000

# 任务栈
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# WiFi / lwIP
CONFIG_LWIP_SO_RCVBUF=16384
# 内部 DRAM 紧：静态 RX 缓冲 16→8（动态缓冲走 PSRAM，语音流量够用；省 ~13KB 内部堆）
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=8
# 静态 TX 缓冲 16→6（每块 ~1.6KB，esp_wifi_start 时分配、永久占内部 RAM）：
# WebRTC 起来后内部堆被吃到 <512B，按住说话时 PDM 麦的 I2S DMA 描述符一块都分不到
# （i2s_alloc_dma_desc failed → 一帧录不到 → 听写永远没文字）。本机流量 <100KB/s，
# 6 静态 + 32 动态（PSRAM）绰绰有余；省 ~16KB 内部堆。
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6

# IRAM 紧张：关 WiFi 驱动的 IRAM 常驻优化（省 ~5KB，不用 light sleep 无影响）
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# lwip：ICE 要开多个 UDP socket + 信号量
CONFIG_LWIP_MAX_ACTIVE_SOCKETS=16
CONFIG_LWIP_MAX_LISTENING_TCP=8

# ★ PSRAM 分配策略（真机踩出来的）：
# 1) malloc 不再「≤16KB 强制内部」：SCTP buf manager 按 MTU 小块分配，全被压进内部堆
#    （8KB 勉强活、24KB 崩、I2S DMA 描述符也被挤死）——改小阈值让它们去 PSRAM
# 2) 内部保留池用真名（SPIRAM_MALLOC_RESERVE_INTERNAL，原名写错过不生效）：48KB 专供 DMA
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152

# 主任务只干轻活（状态机+UI），重活（esp_peer_open）在 peer 任务；32KB 那版把内部 DRAM 挤爆了（thread_sem out of memory）
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# chatserver 只收 TLS 1.3（Go 服务器），ESP-IDF 默认关着，必须开
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_MODE_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=n
# WS 常驻 + HTTP 并发时 mbedtls 内部分配失败（-0x7F00）：把 TLS 会话/缓冲放 PSRAM
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y

# 稳一点：panic 重启；中断看门狗放宽到 500ms（WebRTC+TLS 峰值时 ISR 等待变长）
CONFIG_ESP_INT_WDT_TIMEOUT_MS=500
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
